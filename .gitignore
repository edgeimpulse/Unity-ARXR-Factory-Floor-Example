# ---------------------------------------------------------------------------
# Unity generated folders
# ---------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/

# Never ship Burst debug info
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# ---------------------------------------------------------------------------
# Build artifacts / binaries too large or generated
# ---------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------------
# IDE / solution files (regenerated by Unity)
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---------------------------------------------------------------------------
# Secrets — never commit Edge Impulse API keys or credentials
# ---------------------------------------------------------------------------
.env
*.env
*.secret
*.ei-apikey
.ei-api-key
ei-api-key.txt
secrets.*

# ---------------------------------------------------------------------------
# Edge Impulse native SDK — regenerate with native/fetch_model.sh (too large /
# generated). The compiled plugins in Assets/Plugins/ ARE committed.
# ---------------------------------------------------------------------------
native/edge-impulse-sdk/
native/model-parameters/
native/tflite-model/
native/build/
native/**/*.o
